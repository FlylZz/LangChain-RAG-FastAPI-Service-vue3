# DashScope API Key (必填)
# 前往 https://dashscope.console.aliyun.com/ 注册并获取 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key

# HistoryService 地址
HISTORY_SERVICE_BASE_URL=http://127.0.0.1:8000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=chatbot

# 安全配置
SECRET_KEY=your_secret_key

# 重排序模型配置（可选）
# 如果不配置，将不使用重排序模型
RERANKER_MODEL_PATH=./models/Qwen3-Reranker-0.6B

# LangSmith 配置（可选）
# 前往 https://smith.langchain.com/ 注册获取 API Key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=my-fastapi-langchain-project

# Redis 配置（可选）
REDIS_CACHE_URL=redis://localhost:6379/0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log