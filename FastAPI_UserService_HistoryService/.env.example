# FastAPI_UserService_HistoryService 环境配置示例
# 复制此文件为 .env 并填入实际值

# JWT 配置
# 用于生成和验证 JWT Token
JWT_SECRET_KEY=your_jwt_secret_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168  # 7天

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=user_service

# Redis 配置（可选）
# 用于缓存和会话管理
REDIS_CACHE_URL=redis://localhost:6379/0

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/service.log

# 安全配置
# 密码最小长度
PASSWORD_MIN_LENGTH=6
# 允许上传的文件类型（头像）
ALLOWED_AVATAR_TYPES=jpg,jpeg,png,gif
# 头像最大文件大小（MB）
MAX_AVATAR_SIZE=5

# CORS 配置
# 允许的跨域来源，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000